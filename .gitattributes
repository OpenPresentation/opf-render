# Vendored upstream font files are hashed byte for byte (src/font-manifest.js): never convert line endings.
fonts/**/*.ttf binary
fonts/**/*.txt -text
fonts/intos/NOTICE.md -text
fonts/**/PROVENANCE.json text eol=lf

# The frozen vector-PDF fixture is hashed through its exported PDF: keep its bytes the same on every checkout.
test/fixtures/pdf/*.svg text eol=lf

# dist is the published package and src, scripts its source: a Windows checkout (core.autocrlf=true) must not write CRLF, because the packed bin
# file would start with a CRLF shebang that npm rewrites at install, and every file would differ from the published bytes (core RR-37).
/dist/** text eol=lf
/src/** text eol=lf
/scripts/** text eol=lf
