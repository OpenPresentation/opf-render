# Vendored upstream font files are hashed byte for byte (src/font-manifest.js): never convert line endings.
fonts/**/*.ttf binary
fonts/**/*.txt -text
fonts/intos/NOTICE.md -text
fonts/**/PROVENANCE.json text eol=lf

# The frozen vector-PDF fixture is hashed through its exported PDF: keep its bytes the same on every checkout.
test/fixtures/pdf/*.svg text eol=lf

# npm rewrites the line endings of a bin script on install, so its checkout must already be LF for the installed and staged bytes to match (Windows ecosystem CI).
dist/preview-fonts-cli.js text eol=lf
src/preview-fonts-cli.js text eol=lf
